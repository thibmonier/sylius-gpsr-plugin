<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">

    <mapped-superclass name="Tmonier\SyliusGpsrPlugin\Entity\Manufacturer" table="tmonier_gpsr_manufacturer">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="code" column="code" type="string" length="255" unique="true" />
        <field name="name" column="name" type="string" length="255" />
        <field name="tradeMark" column="trade_mark" type="string" length="255" nullable="true" />
        <field name="street" column="street" type="string" length="255" />
        <field name="postcode" column="postcode" type="string" length="32" />
        <field name="city" column="city" type="string" length="255" />
        <field name="countryCode" column="country_code" type="string" length="2" />
        <field name="email" column="email" type="string" length="255" />
        <field name="website" column="website" type="string" length="255" nullable="true" />

        <many-to-one field="defaultResponsiblePerson" target-entity="Tmonier\SyliusGpsrPlugin\Entity\ResponsiblePersonInterface">
            <join-column name="default_responsible_person_id" referenced-column-name="id" nullable="true" on-delete="SET NULL" />
        </many-to-one>
    </mapped-superclass>

</doctrine-mapping>
