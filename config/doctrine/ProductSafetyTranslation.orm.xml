<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">

    <!-- The translatable relation, the locale field and the unique (translatable, locale) constraint are added by the Sylius translatable listener. -->
    <mapped-superclass name="Tmonier\SyliusGpsrPlugin\Entity\ProductSafetyTranslation" table="tmonier_gpsr_product_safety_translation">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="warnings" column="warnings" type="text" nullable="true" />
        <field name="safetyInformation" column="safety_information" type="text" nullable="true" />
    </mapped-superclass>

</doctrine-mapping>
