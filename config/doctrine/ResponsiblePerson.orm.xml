<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">

    <mapped-superclass name="Tmonier\SyliusGpsrPlugin\Entity\ResponsiblePerson" table="tmonier_gpsr_responsible_person">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="code" column="code" type="string" length="255" unique="true" />
        <field name="name" column="name" type="string" length="255" />
        <field name="role" column="role" type="string" length="64" />
        <field name="street" column="street" type="string" length="255" />
        <field name="postcode" column="postcode" type="string" length="32" />
        <field name="city" column="city" type="string" length="255" />
        <field name="countryCode" column="country_code" type="string" length="2" />
        <field name="email" column="email" type="string" length="255" />
        <field name="phone" column="phone" type="string" length="64" nullable="true" />
    </mapped-superclass>

</doctrine-mapping>
